# Copy this file to .env and fill in your keys. Both are free.
# Congress.gov API key (federal bills): https://api.congress.gov/sign-up/
CONGRESS_API_KEY=
# Open States / Plural key (Virginia General Assembly): https://open.pluralpolicy.com/accounts/signup/
OPENSTATES_API_KEY=
PORT=3000
# Saved Senate votes. On this computer, `vercel env pull` writes it to .env.local.
# Other Neon names in .env.local can be ignored; the app only reads DATABASE_URL.
DATABASE_URL=
